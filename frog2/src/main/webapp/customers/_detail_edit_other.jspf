<%@ page pageEncoding="UTF-8" %>
<c:remove var="editEosDate" scope="page" />
<c:set var="editEosDate" value="${customer.verticaEos}" />
<c:if test="${not empty editDetail.eosDate}">
    <fmt:formatDate var="editEosDate" value="${editDetail.eosDate}" pattern="yyyy-MM-dd" />
</c:if>

<details class="detail-section detail-section--collapsible" data-detail-section open>
    <summary class="detail-section-title">
        <i class="fas fa-ellipsis-h" aria-hidden="true"></i>
        기타 정보
        <span class="detail-section-count" data-detail-section-count></span>
    </summary>
    <div class="detail-grid">
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="eosDate" label="EOS 일자"
                inputType="date" value="${editEosDate}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="customerType" label="고객 유형"
                inputType="select"
                options="정기점검 계약 고객사:정기점검 계약 고객사|납품 계약 고객사:납품 계약 고객사|유지보수 종료 고객사:유지보수 종료 고객사"
                value="${not empty editDetail.customerType ? editDetail.customerType : customer.customerType}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="note" label="비고"
                inputType="textarea" fullWidth="${true}"
                value="${not empty editDetail.note ? editDetail.note : customer.note}"
                placeholder="기타 참고사항" />
    </div>
</details>
