<%@ page pageEncoding="UTF-8" %>
<c:set var="eonFieldsDisabled"
       value="${empty editDetail.dbMode or editDetail.dbMode ne 'EON'}" />
<details class="detail-section detail-section--collapsible" data-detail-section open>
    <summary class="detail-section-title">
        <i class="fas fa-server" aria-hidden="true"></i>
        인프라·네트워크
        <span class="detail-section-count" data-detail-section-count></span>
    </summary>
    <div class="detail-grid">
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="memoryInfo" label="메모리"
                value="${editDetail.memoryInfo}" placeholder="예: 512GB" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="infraType" label="인프라 유형"
                inputType="select"
                options="온프레미스:온프레미스|클라우드:클라우드|하이브리드:하이브리드"
                value="${editDetail.infraType}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="swapMemory" label="SWAP 메모리"
                value="${editDetail.swapMemory}" placeholder="예: 32GB" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="dataArea" label="데이터 영역"
                value="${editDetail.dataArea}" placeholder="예: 20TB" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="cpuSocket" label="CPU 소켓"
                value="${editDetail.cpuSocket}" placeholder="CPU 소켓 수" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="catalogArea" label="카탈로그 영역"
                value="${editDetail.catalogArea}" placeholder="예: 500GB" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="cpuCore" label="CPU 코어"
                value="${editDetail.cpuCore}" placeholder="CPU 코어 수" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="depotArea" label="Depot 영역"
                value="${eonFieldsDisabled ? '미사용' : editDetail.depotArea}" placeholder="예: 2TB"
                disabled="${eonFieldsDisabled}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="hyperThreading" label="하이퍼스레딩"
                inputType="select" options="Y:사용|N:미사용" value="${editDetail.hyperThreading}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="objectArea" label="Object 영역"
                value="${eonFieldsDisabled ? '미사용' : editDetail.objectArea}" placeholder="Object Storage 정보"
                disabled="${eonFieldsDisabled}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="publicNetwork" label="Public 네트워크"
                value="${editDetail.publicNetwork}" placeholder="대역 또는 미사용"
                columnStart="${true}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="privateNetwork" label="Private 네트워크"
                value="${editDetail.privateNetwork}" placeholder="대역 또는 미사용"
                columnStart="${true}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="storageNetwork" label="스토리지 네트워크"
                value="${eonFieldsDisabled ? '미사용' : editDetail.storageNetwork}" placeholder="대역 또는 미사용"
                columnStart="${true}" disabled="${eonFieldsDisabled}" />
    </div>
</details>
