<%@ page pageEncoding="UTF-8" %>
<details class="detail-section detail-section--collapsible" data-detail-section open>
    <summary class="detail-section-title">
        <i class="fas fa-puzzle-piece" aria-hidden="true"></i>
        연계 솔루션
        <span class="detail-section-count" data-detail-section-count></span>
    </summary>
    <div class="detail-grid">
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="etlTool" label="ETL"
                value="${not empty editDetail.etlTool ? editDetail.etlTool : customer.etlTool}"
                placeholder="예: Informatica, DataStage" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="biTool" label="BI"
                value="${not empty editDetail.biTool ? editDetail.biTool : customer.biTool}"
                placeholder="예: Tableau, Power BI" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="dbEncryption" label="DB 암호화"
                inputType="select" options="적용:적용|미적용:미적용|부분적용:부분 적용"
                value="${not empty editDetail.dbEncryption ? editDetail.dbEncryption : customer.dbEncryption}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="cdcTool" label="CDC"
                value="${not empty editDetail.cdcTool ? editDetail.cdcTool : customer.cdcTool}"
                placeholder="예: Oracle GoldenGate" />
    </div>
</details>
