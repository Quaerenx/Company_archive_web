<%@ page pageEncoding="UTF-8" %>
<c:remove var="detailCreateDate" scope="page" />
<c:remove var="detailInstallDate" scope="page" />
<c:remove var="detailEosDate" scope="page" />
<fmt:formatDate var="detailCreateDate" value="${detail.createDate}" pattern="yyyy-MM-dd" />
<fmt:formatDate var="detailInstallDate" value="${detail.installDate}" pattern="yyyy-MM-dd" />
<fmt:formatDate var="detailEosDate" value="${detail.eosDate}" pattern="yyyy-MM-dd" />

<div class="environment-detail ui-detail">
    <section class="detail-section detail-section--summary">
        <div class="detail-section-title">
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            핵심 정보
        </div>
        <div class="detail-grid detail-grid--summary">
            <t:detailField label="DB명" value="${detail.dbName}" />
            <t:detailField label="Vertica 버전" value="${detail.verticaVersion}" />
            <t:detailField label="DB 모드" value="${detail.dbMode}" />
            <t:detailField label="노드 수" value="${detail.nodeCount}" />
            <t:detailField label="라이선스" value="${detail.licenseInfo}" />
            <t:detailField label="OS" value="${detail.osInfo}" />
            <t:detailField label="주 담당자" value="${detail.mainManager}" />
            <t:detailField label="SAID" value="${detail.said}" />
        </div>
    </section>

    <section class="detail-section">
        <div class="detail-section-title">
            <i class="fas fa-address-card" aria-hidden="true"></i>
            기본·담당자 정보
        </div>
        <div class="detail-grid">
            <t:detailField label="고객사" value="${detail.customerName}" />
            <t:detailField label="시스템명" value="${detail.systemName}" />
            <t:detailField label="고객사 담당자" value="${detail.customerManager}" />
            <t:detailField label="담당 SI" value="${detail.siCompany}" />
            <t:detailField label="SI 담당자" value="${detail.siManager}" />
            <t:detailField label="부 담당자" value="${detail.subManager}" />
            <t:detailField label="도입 연도" value="${detail.introductionYear}" />
            <t:detailField label="설치일" value="${detailInstallDate}" />
            <t:detailField label="작성자" value="${detail.creator}" />
            <t:detailField label="작성일" value="${detailCreateDate}" />
        </div>
    </section>

    <details class="detail-section detail-section--collapsible" open>
        <summary class="detail-section-title">
            <i class="fas fa-database" aria-hidden="true"></i>
            Vertica 운영 설정
        </summary>
        <div class="detail-grid">
            <t:detailField label="Vertica 관리자" value="${detail.verticaAdmin}" />
            <t:detailField label="Subcluster 사용" value="${detail.subclusterYn}" booleanState="${true}" />
            <t:detailField label="MC 사용" value="${detail.mcYn}" booleanState="${true}" />
            <c:if test="${not empty detail.mcHost}"><t:detailField label="MC 호스트" value="${detail.mcHost}" /></c:if>
            <c:if test="${not empty detail.mcVersion}"><t:detailField label="MC 버전" value="${detail.mcVersion}" /></c:if>
            <c:if test="${not empty detail.mcAdmin}"><t:detailField label="MC 관리자" value="${detail.mcAdmin}" /></c:if>
            <t:detailField label="백업 사용" value="${detail.backupYn}" booleanState="${true}" />
            <t:detailField label="사용자 정의 리소스 풀" value="${detail.customResourcePoolYn}" booleanState="${true}" />
            <c:if test="${not empty detail.backupNote}"><t:detailField label="백업 비고" value="${detail.backupNote}" fullWidth="${true}" multiline="${true}" /></c:if>
        </div>
    </details>

    <details class="detail-section detail-section--collapsible" open>
        <summary class="detail-section-title">
            <i class="fas fa-server" aria-hidden="true"></i>
            인프라·네트워크
        </summary>
        <div class="detail-grid">
            <t:detailField label="메모리" value="${detail.memoryInfo}" />
            <t:detailField label="인프라 유형" value="${detail.infraType}" />
            <t:detailField label="CPU 소켓" value="${detail.cpuSocket}" />
            <t:detailField label="하이퍼스레딩" value="${detail.hyperThreading}" booleanState="${true}" />
            <t:detailField label="CPU 코어" value="${detail.cpuCore}" />
            <t:detailField label="데이터 영역" value="${detail.dataArea}" />
            <t:detailField label="Depot 영역" value="${detail.depotArea}" />
            <t:detailField label="카탈로그 영역" value="${detail.catalogArea}" />
            <t:detailField label="Object 영역" value="${detail.objectArea}" />
            <t:detailField label="Public 네트워크 사용" value="${detail.publicYn}" booleanState="${true}" />
            <c:if test="${not empty detail.publicNetwork}"><t:detailField label="Public 네트워크 대역" value="${detail.publicNetwork}" /></c:if>
            <t:detailField label="Private 네트워크 사용" value="${detail.privateYn}" booleanState="${true}" />
            <c:if test="${not empty detail.privateNetwork}"><t:detailField label="Private 네트워크 대역" value="${detail.privateNetwork}" /></c:if>
            <t:detailField label="스토리지 네트워크 사용" value="${detail.storageYn}" booleanState="${true}" />
            <c:if test="${not empty detail.storageNetwork}"><t:detailField label="스토리지 네트워크 대역" value="${detail.storageNetwork}" /></c:if>
        </div>
    </details>

    <details class="detail-section detail-section--collapsible" open>
        <summary class="detail-section-title">
            <i class="fas fa-puzzle-piece" aria-hidden="true"></i>
            연계 솔루션
        </summary>
        <div class="detail-grid">
            <t:detailField label="ETL" value="${detail.etlTool}" />
            <t:detailField label="BI" value="${detail.biTool}" />
            <t:detailField label="DB 암호화" value="${detail.dbEncryption}" />
            <t:detailField label="CDC" value="${detail.cdcTool}" />
        </div>
    </details>

    <details class="detail-section detail-section--collapsible" open>
        <summary class="detail-section-title">
            <i class="fas fa-ellipsis-h" aria-hidden="true"></i>
            기타 정보
        </summary>
        <div class="detail-grid">
            <t:detailField label="EOS 일자" value="${detailEosDate}" />
            <t:detailField label="고객 유형" value="${detail.customerType}" />
            <t:detailField label="비고" value="${detail.note}" fullWidth="${true}" multiline="${true}" />
        </div>
    </details>
</div>
