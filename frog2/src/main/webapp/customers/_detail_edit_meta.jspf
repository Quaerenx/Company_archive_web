<%@ page pageEncoding="UTF-8" %>
<c:remove var="editCreateDate" scope="page" />
<c:remove var="editInstallDate" scope="page" />
<fmt:formatDate var="editCreateDate" value="${editDetail.createDate}" pattern="yyyy-MM-dd" />
<fmt:formatDate var="editInstallDate" value="${editDetail.installDate}" pattern="yyyy-MM-dd" />

<details class="detail-section detail-section--collapsible" data-detail-section open>
    <summary class="detail-section-title">
        <i class="fas fa-address-card" aria-hidden="true"></i>
        기본·담당자 정보
        <span class="detail-section-count" data-detail-section-count></span>
    </summary>
    <div class="detail-grid">
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="customerName" label="고객사"
                value="${not empty editDetail.customerName ? editDetail.customerName : customer.customerName}"
                readonly="${true}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="systemName" label="시스템명"
                value="${editDetail.systemName}" placeholder="시스템명" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="customerManager" label="고객사 담당자"
                value="${editDetail.customerManager}" placeholder="고객사 담당자" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="siManager" label="SI 담당자"
                value="${editDetail.siManager}" placeholder="SI 담당자" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="siCompany" label="담당 SI"
                value="${editDetail.siCompany}" placeholder="담당 SI" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="subManager" label="부 담당자"
                value="${not empty editDetail.subManager ? editDetail.subManager : customer.subManagerName}"
                placeholder="부 담당자" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="introductionYear" label="도입 연도"
                inputType="number" min="2000"
                value="${not empty editDetail.introductionYear ? editDetail.introductionYear : customer.firstIntroductionYear}"
                placeholder="YYYY" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="installDate" label="설치일"
                inputType="date" value="${editInstallDate}" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="creator" label="작성자"
                value="${editDetail.creator}" placeholder="작성자" />
        <t:customerDetailEditField idPrefix="${editIdPrefix}" name="createDate" label="작성일"
                inputType="date" value="${editCreateDate}" />
    </div>
</details>
