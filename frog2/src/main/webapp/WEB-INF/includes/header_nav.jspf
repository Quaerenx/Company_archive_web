<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<c:set var="navRequestUri" value="${requestScope['jakarta.servlet.forward.request_uri']}" />
<c:if test="${empty navRequestUri}">
    <c:set var="navRequestUri" value="${pageContext.request.requestURI}" />
</c:if>

<c:set var="navDashboardPath" value="${pageContext.request.contextPath}/dashboard" />
<c:set var="navDashboardJspPath" value="${pageContext.request.contextPath}/dashboard.jsp" />
<c:set var="navContextRootPath" value="${pageContext.request.contextPath}/" />
<c:set var="navVmHostsPath" value="${pageContext.request.contextPath}/vm-hosts" />
<c:set var="navVmHostsPrefix" value="${navVmHostsPath}/" />
<c:set var="navVmHostsLegacyPath" value="${pageContext.request.contextPath}/vm_hosts" />
<c:set var="navVmHostsLegacyPrefix" value="${navVmHostsLegacyPath}/" />
<c:set var="navCustomersPath" value="${pageContext.request.contextPath}/customers" />
<c:set var="navCustomersPrefix" value="${navCustomersPath}/" />
<c:set var="navMaintenancePath" value="${pageContext.request.contextPath}/maintenance" />
<c:set var="navMaintenancePrefix" value="${navMaintenancePath}/" />
<c:set var="navMeetingPath" value="${pageContext.request.contextPath}/meeting" />
<c:set var="navMeetingPrefix" value="${navMeetingPath}/" />
<c:set var="navFileRepositoryPath" value="${pageContext.request.contextPath}/file-repository" />
<c:set var="navFileRepositoryPrefix" value="${navFileRepositoryPath}/" />
<c:set var="navLegacyFileRepositoryPath" value="${pageContext.request.contextPath}/filerepo" />
<c:set var="navLegacyFileRepositoryPrefix" value="${navLegacyFileRepositoryPath}/" />
<c:set var="navTroubleshootingPath" value="${pageContext.request.contextPath}/troubleshooting" />
<c:set var="navTroubleshootingPrefix" value="${navTroubleshootingPath}/" />
<c:set var="navMyPagePath" value="${pageContext.request.contextPath}/mypage" />
<c:set var="navMyPagePrefix" value="${navMyPagePath}/" />

<c:set var="navDashboardCurrent"
       value="${navRequestUri eq navDashboardPath
               || navRequestUri eq navDashboardJspPath
               || navRequestUri eq navContextRootPath
               || navRequestUri eq pageContext.request.contextPath
               || navRequestUri eq navVmHostsPath
               || fn:startsWith(navRequestUri, navVmHostsPrefix)
               || navRequestUri eq navVmHostsLegacyPath
               || fn:startsWith(navRequestUri, navVmHostsLegacyPrefix)}" />
<c:set var="navCustomersCurrent"
       value="${navRequestUri eq navCustomersPath || fn:startsWith(navRequestUri, navCustomersPrefix)}" />
<c:set var="navMaintenanceCurrent"
       value="${navRequestUri eq navMaintenancePath || fn:startsWith(navRequestUri, navMaintenancePrefix)}" />
<c:set var="navMeetingCurrent"
       value="${navRequestUri eq navMeetingPath || fn:startsWith(navRequestUri, navMeetingPrefix)}" />
<c:set var="navFileRepositoryCurrent"
       value="${navRequestUri eq navFileRepositoryPath
               || fn:startsWith(navRequestUri, navFileRepositoryPrefix)
               || navRequestUri eq navLegacyFileRepositoryPath
               || fn:startsWith(navRequestUri, navLegacyFileRepositoryPrefix)}" />
<c:set var="navTroubleshootingCurrent"
       value="${navRequestUri eq navTroubleshootingPath
               || fn:startsWith(navRequestUri, navTroubleshootingPrefix)}" />
<c:set var="navMyPageCurrent"
       value="${navRequestUri eq navMyPagePath || fn:startsWith(navRequestUri, navMyPagePrefix)}" />
<c:set var="navCustomerSectionCurrent"
       value="${navCustomersCurrent || navMaintenanceCurrent}" />
<c:set var="navResourceSectionCurrent"
       value="${navMeetingCurrent || navFileRepositoryCurrent || navTroubleshootingCurrent}" />

<header class="main-header" data-csrf-token="${csrfToken}">
    <div class="header-box">
        <div class="container">
            <div class="logo">
                <a href="${pageContext.request.contextPath}/dashboard"
                   class="brand-link"
                   aria-label="Archive 대시보드">
                    <img class="brand-logo"
                         src="${pageContext.request.contextPath}/resources/images/archive-compact-horizontal.svg"
                         width="373"
                         height="112"
                         alt=""
                         aria-hidden="true">
                </a>
            </div>

            <button type="button"
                    id="mobileNavToggle"
                    class="mobile-nav-toggle"
                    aria-controls="primaryNavigation"
                    aria-expanded="false"
                    aria-label="메뉴 열기"
                    hidden>
                <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
                <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
                <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
            </button>

            <nav id="primaryNavigation" class="main-nav" aria-label="주요 메뉴">
                <ul class="nav-list">
                    <li>
                        <a href="${pageContext.request.contextPath}/dashboard"
                           class="nav-link${navDashboardCurrent ? ' active' : ''}"
                           aria-current="${navDashboardCurrent ? 'page' : 'false'}">
                            <i class="fas fa-tachometer-alt mr-1" aria-hidden="true"></i>
                            <span>대시보드</span>
                        </a>
                    </li>

                    <li class="dropdown${navCustomerSectionCurrent ? ' current-section' : ''}">
                        <button type="button"
                                id="customerNavToggle"
                                class="dropdown-toggle${navCustomerSectionCurrent ? ' active' : ''}"
                                aria-controls="customerNavMenu"
                                aria-expanded="false">
                            <i class="fas fa-building mr-1" aria-hidden="true"></i>
                            <span>고객관리</span>
                            <i class="fas fa-chevron-down dropdown-chevron" aria-hidden="true"></i>
                        </button>
                        <ul id="customerNavMenu"
                            class="dropdown-menu"
                            aria-labelledby="customerNavToggle">
                            <li>
                                <a href="${pageContext.request.contextPath}/customers?view=list"
                                   class="${navCustomersCurrent ? 'active' : ''}"
                                   aria-current="${navCustomersCurrent ? 'page' : 'false'}">
                                    <i class="fas fa-address-card mr-2" aria-hidden="true"></i>
                                    고객사 정보
                                </a>
                            </li>
                            <li>
                                <a href="${pageContext.request.contextPath}/maintenance"
                                   class="${navMaintenanceCurrent ? 'active' : ''}"
                                   aria-current="${navMaintenanceCurrent ? 'page' : 'false'}">
                                    <i class="fas fa-clipboard-check mr-2" aria-hidden="true"></i>
                                    정기점검 이력
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="dropdown${navResourceSectionCurrent ? ' current-section' : ''}">
                        <button type="button"
                                id="resourceNavToggle"
                                class="dropdown-toggle${navResourceSectionCurrent ? ' active' : ''}"
                                aria-controls="resourceNavMenu"
                                aria-expanded="false">
                            <i class="fas fa-folder mr-1" aria-hidden="true"></i>
                            <span>자료관리</span>
                            <i class="fas fa-chevron-down dropdown-chevron" aria-hidden="true"></i>
                        </button>
                        <ul id="resourceNavMenu"
                            class="dropdown-menu"
                            aria-labelledby="resourceNavToggle">
                            <li>
                                <a href="${pageContext.request.contextPath}/meeting?view=list"
                                   class="${navMeetingCurrent ? 'active' : ''}"
                                   aria-current="${navMeetingCurrent ? 'page' : 'false'}">
                                    <i class="fas fa-clipboard-list mr-2" aria-hidden="true"></i>
                                    회의록
                                </a>
                            </li>
                            <li>
                                <a href="${pageContext.request.contextPath}/file-repository"
                                   class="${navFileRepositoryCurrent ? 'active' : ''}"
                                   aria-current="${navFileRepositoryCurrent ? 'page' : 'false'}">
                                    <i class="fas fa-file-alt mr-2" aria-hidden="true"></i>
                                    자료실
                                </a>
                            </li>
                            <li>
                                <a href="${pageContext.request.contextPath}/troubleshooting?view=list"
                                   class="${navTroubleshootingCurrent ? 'active' : ''}"
                                   aria-current="${navTroubleshootingCurrent ? 'page' : 'false'}">
                                    <i class="fas fa-tools mr-2" aria-hidden="true"></i>
                                    트러블슈팅
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="quick-nav-item">
                        <button type="button"
                                id="quickNavOpenButton"
                                class="nav-link quick-nav-trigger"
                                aria-haspopup="dialog"
                                aria-controls="quickNavDialog"
                                aria-expanded="false"
                                aria-keyshortcuts="Control+K Meta+K">
                            <i class="fas fa-search mr-1" aria-hidden="true"></i>
                            <span>빠른 이동</span>
                            <span class="quick-nav-shortcut" aria-hidden="true">Ctrl K</span>
                        </button>
                    </li>

                    <li>
                        <a href="${pageContext.request.contextPath}/mypage"
                           class="nav-link${navMyPageCurrent ? ' active' : ''}"
                           aria-current="${navMyPageCurrent ? 'page' : 'false'}">
                            <i class="fas fa-user mr-1" aria-hidden="true"></i>
                            <span>마이페이지</span>
                        </a>
                    </li>

                    <li>
                        <a id="logoutLink"
                           class="nav-link"
                           href="${pageContext.request.contextPath}/logout">
                            <i class="fas fa-sign-out-alt mr-1" aria-hidden="true"></i>
                            <span>로그아웃</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<div id="quickNavBackdrop"
     class="quick-nav-backdrop"
     aria-hidden="true"
     hidden>
    <section id="quickNavDialog"
             class="quick-nav-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="quickNavTitle"
             aria-describedby="quickNavDescription"
             aria-hidden="true"
             tabindex="-1">
        <header class="quick-nav-header">
            <div>
                <h2 id="quickNavTitle">빠른 이동</h2>
                <p id="quickNavDescription">메뉴 이름을 검색한 뒤 Enter로 이동하세요.</p>
            </div>
            <button type="button"
                    id="quickNavCloseButton"
                    class="quick-nav-close ui-touch-target"
                    aria-label="빠른 이동 닫기">&times;</button>
        </header>
        <div class="quick-nav-search">
            <label class="sr-only" for="quickNavInput">메뉴 검색</label>
            <i class="fas fa-search" aria-hidden="true"></i>
            <input id="quickNavInput"
                   type="search"
                   autocomplete="off"
                   spellcheck="false"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-controls="quickNavResults"
                   aria-expanded="false"
                   data-dialog-initial-focus
                   placeholder="대시보드, 고객사, 정기점검…">
        </div>
        <ul id="quickNavResults"
            class="quick-nav-results"
            role="listbox"
            aria-label="이동할 메뉴"></ul>
        <p id="quickNavEmpty" class="quick-nav-empty" role="status" hidden>
            일치하는 메뉴가 없습니다.
        </p>
        <p class="quick-nav-help">
            <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> 선택</span>
            <span><kbd>Enter</kbd> 이동</span>
            <span><kbd>Esc</kbd> 닫기</span>
        </p>
    </section>
</div>

<script src="${pageContext.request.contextPath}/resources/js/header_nav.js?v=${frog2AssetVersion}"></script>
