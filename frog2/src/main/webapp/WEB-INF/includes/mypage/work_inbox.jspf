<%@ page pageEncoding="UTF-8" %>
<section class="mypage-section work-inbox" aria-labelledby="workInboxTitle">
    <div class="mypage-section__header work-inbox__header">
        <div>
            <h2 id="workInboxTitle">업무 인박스</h2>
            <p class="work-inbox__summary">
                담당 고객사에서 확인이 필요한 항목
                <strong><c:out value="${empty workInbox.totalCount ? 0 : workInbox.totalCount}" />건</strong>
            </p>
        </div>
        <c:if test="${not empty workInbox.items}">
            <ul class="work-inbox__counts" aria-label="업무 인박스 상태별 건수">
                <c:if test="${workInbox.dangerCount > 0}">
                    <li class="work-inbox__count work-inbox__count--danger">
                        위험 <strong><c:out value="${workInbox.dangerCount}" /></strong>
                    </li>
                </c:if>
                <c:if test="${workInbox.warningCount > 0}">
                    <li class="work-inbox__count work-inbox__count--warning">
                        확인 필요 <strong><c:out value="${workInbox.warningCount}" /></strong>
                    </li>
                </c:if>
                <c:if test="${workInbox.infoCount > 0}">
                    <li class="work-inbox__count">
                        정보 누락 <strong><c:out value="${workInbox.infoCount}" /></strong>
                    </li>
                </c:if>
            </ul>
        </c:if>
    </div>

    <c:choose>
        <c:when test="${not empty workInbox.items}">
            <ul class="work-inbox__list">
                <c:forEach var="item" items="${workInbox.items}">
                    <c:url var="workInboxItemUrl" value="${item.path}" />
                    <li class="work-inbox__item">
                        <a class="work-inbox__link"
                           href="<c:out value='${workInboxItemUrl}' />">
                            <span class="ui-badge ui-badge--<c:out value='${item.tone}' />">
                                <c:out value="${item.severityLabel}" />
                            </span>
                            <span class="work-inbox__content">
                                <span class="work-inbox__customer"><c:out value="${item.customerName}" /></span>
                                <strong class="work-inbox__title"><c:out value="${item.title}" /></strong>
                                <span class="work-inbox__detail"><c:out value="${item.detail}" /></span>
                            </span>
                            <span class="work-inbox__arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                </c:forEach>
            </ul>
            <c:if test="${workInbox.hiddenCount > 0}">
                <p class="work-inbox__more">
                    우선순위가 높은 8건을 표시했습니다.
                    그 외 <strong><c:out value="${workInbox.hiddenCount}" />건</strong>
                </p>
            </c:if>
        </c:when>
        <c:otherwise>
            <div class="work-inbox__empty ui-empty-state">
                <strong>현재 확인할 담당 고객사 항목이 없습니다.</strong>
            </div>
        </c:otherwise>
    </c:choose>
</section>
